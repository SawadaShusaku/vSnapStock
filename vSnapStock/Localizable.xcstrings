{
  "sourceLanguage": "ja",
  "strings": {
    "": {},
    "%@: %@": {
      "comment": "A label displaying the date a card's consumed-by date, with a caption indicating that it represents the expiration date. The argument is the formatted date. The argument is the string “date.use_by”.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@: %2$@"
          }
        }
      }
    },
    "%lld": {
      "comment": "The value displayed next to the red slider, showing the corresponding RGB value as a number between 0 and 255.",
      "isCommentAutoGenerated": true
    },
    "%lld%%": {
      "comment": "A label displaying the alpha value as a percentage. The argument is the alpha value as a decimal.",
      "isCommentAutoGenerated": true
    },
    "%lld°": {
      "comment": "A text field displaying the current angle of the gradient.",
      "isCommentAutoGenerated": true
    },
    "1x": {
      "comment": "A label indicating a zoom factor of 1x.",
      "isCommentAutoGenerated": true
    },
    "2x": {
      "comment": "The zoom factor label when the zoom is set to 2x.",
      "isCommentAutoGenerated": true
    },
    "A": {
      "comment": "A label displayed next to a slider for adjusting the alpha value of a color.",
      "isCommentAutoGenerated": true
    },
